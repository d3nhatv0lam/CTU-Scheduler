<rxui:ReactiveUserControl
    x:TypeArguments="viewModels:AvoidanceFilterViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" d:DesignWidth="280" d:DesignHeight="50"
    xmlns:rxui="http://reactiveui.net"
    x:DataType="viewModels:AvoidanceFilterViewModel"
    x:CompileBindings="True"
    xmlns:viewModels="clr-namespace:CTUScheduler.Presentation.Features.Scheduling.ViewModels.Components"
    xmlns:models="clr-namespace:CTUScheduler.Presentation.Features.Scheduling.Models"
    x:Class="CTUScheduler.Presentation.Features.Scheduling.Views.Components.AvoidanceFilterView">

    <rxui:ReactiveUserControl.Styles>
        <StyleInclude Source="avares://CTUScheduler/Presentation/Shared/Styles/Controls.axaml" />
        <StyleInclude Source="avares://CTUScheduler/Presentation/Features/Scheduling/Shared/Styles/controls.axaml" />

        <Style Selector="ComboBox.CourseCombo ComboBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ComboBox.CourseCombo ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ComboBox.CourseCombo ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>
        <Style Selector="ComboBox.CourseCombo ComboBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- SubCombo -->
        <Style Selector="ComboBox.SubCombo">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8 2" />
            <Setter Property="Background" Value="White" />
        </Style>
        <Style Selector="ComboBox.SubCombo:pointerover /template/ Border#PART_Border">
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
        </Style>
        <Style Selector="ComboBox.SubCombo[IsDropDownOpen=True] /template/ Border#PART_Border">
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
        </Style>
        <Style Selector="ComboBox.SubCombo[IsDropDownOpen=True] /template/ PathIcon">
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
        </Style>

        <!-- SubCombo Popup Items-->
        <Style Selector="ComboBox.SubCombo ComboBoxItem">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10 8" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Margin" Value="2 1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ComboBox.SubCombo ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F5F5F5" />
        </Style>
        <Style Selector="ComboBox.SubCombo ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#EBF4FF" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
        </Style>
        <Style Selector="ComboBox.SubCombo ComboBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#DCEEFF" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
        </Style>

        <Style Selector="Border.DayRowBorder">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.DayRowBorder:pointerover">
            <Setter Property="Background" Value="#F5F5F5" />
        </Style>
        <Style Selector="Border.DayRowBorder.is-avoided">
            <Setter Property="Background" Value="#EBF4FF" />
        </Style>
        <Style Selector="Border.DayRowBorder.is-avoided:pointerover">
            <Setter Property="Background" Value="#DCEEFF" />
        </Style>

        <Style Selector="Button.ClearBtn">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="6 3" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource RedColor}" />
        </Style>
        <Style Selector="Button.ClearBtn:disabled">
            <Setter Property="Opacity" Value="0.35" />
        </Style>
    </rxui:ReactiveUserControl.Styles>

    <Grid Margin="0 8 0 8">
        <ComboBox Classes="CourseCombo"
                  PlaceholderText="{Binding SummaryText}"
                  ItemsSource="{Binding Days}"
                  HorizontalAlignment="Stretch"
                  SelectionChanged="OnComboBoxSelectionChanged">
            <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="viewModels:DayAvoidanceItemViewModel">
                    <Border Classes="DayRowBorder"
                            Classes.is-avoided="{Binding IsAvoided}"
                            Padding="4 3"
                            Margin="1 1"
                            CornerRadius="4">
                        <Grid ColumnDefinitions="115 *" Margin="2 1">
                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding IsAvoided}"
                                      Content="{Binding FullLabel}"
                                      FontSize="12"
                                      Cursor="Hand"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      VerticalContentAlignment="Center"
                                      Background="Transparent" />

                            <ComboBox Grid.Column="1"
                                      Classes="SubCombo"
                                      IsEnabled="{Binding IsAvoided}"
                                      ItemsSource="{Binding Options}"
                                      SelectedItem="{Binding SelectedOption}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:DayAvoidanceOption">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="12" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Text="Tránh học ngày / buổi"
                   FontSize="11"
                   FontWeight="Bold"
                   Background="White"
                   Padding="4 0"
                   Margin="10 -7 0 0"
                   VerticalAlignment="Top"
                   HorizontalAlignment="Left"
                   Foreground="{StaticResource PrimaryBrush}"
                   IsHitTestVisible="False" />
    </Grid>
</rxui:ReactiveUserControl>
